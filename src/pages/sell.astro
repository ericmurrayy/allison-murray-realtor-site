---
import BaseLayout from '../layouts/BaseLayout.astro';

const sellingSteps = [
  {
    number: "01",
    title: "Free Home Valuation",
    description: "We'll analyze comparable sales, market trends, and your home's unique features to determine its true market value."
  },
  {
    number: "02",
    title: "Strategic Pricing",
    description: "Based on current market conditions, we'll develop a pricing strategy designed to attract qualified buyers and maximize your sale price."
  },
  {
    number: "03",
    title: "Professional Marketing",
    description: "High-quality photography, virtual tours, targeted digital marketing, and exposure to our network of qualified buyers."
  },
  {
    number: "04",
    title: "Showings & Open Houses",
    description: "We coordinate and manage all showings, providing feedback and adjusting strategy as needed."
  },
  {
    number: "05",
    title: "Negotiate & Close",
    description: "Expert negotiation to secure the best terms, plus seamless coordination through inspection, appraisal, and closing."
  }
];

const faqs = [
  {
    question: "How do you determine my home's value?",
    answer: "I conduct a comprehensive market analysis (CMA) that examines recent sales of comparable homes in your neighborhood, current market conditions, your home's unique features, and buyer demand. This data-driven approach ensures accurate pricing."
  },
  {
    question: "How long will it take to sell my home?",
    answer: "In the current Greater Boston market, well-priced homes typically sell within 2-4 weeks. However, timing depends on factors like location, price point, condition, and market conditions. I'll give you a realistic timeline based on your specific situation."
  },
  {
    question: "What do I need to do to prepare my home for sale?",
    answer: "I provide a personalized preparation checklist based on your home. Generally, decluttering, minor repairs, and deep cleaning make the biggest impact. I also offer staging consultations and can recommend trusted contractors if needed."
  },
  {
    question: "What are your fees?",
    answer: "My commission is competitive with the local market and only paid at closing when your home sells. During our initial consultation, I'll explain all costs transparently so there are no surprises."
  },
  {
    question: "Can I sell my home while still living in it?",
    answer: "Absolutely! Most of my clients live in their homes during the sale. I'll work with your schedule for showings and provide tips to keep your home show-ready with minimal disruption to your daily life."
  }
];

const marketing = [
  { image: "/images/interior-kitchen.jpg", alt: "Bright, professionally staged kitchen", label: "Professional Photography" },
  { image: "/images/interior-living.jpg", alt: "Elegant staged living room", label: "Staging Consultation" },
  { image: "/images/interior-dining.jpg", alt: "Sunlit dining room with bay windows", label: "3D Virtual Tours" },
  { image: "/images/interior-family.jpg", alt: "Warm family room with large windows", label: "Targeted Digital Marketing" },
];

const towns = ["Wellesley", "Weston", "Newton", "Lexington", "Needham", "Natick", "Waltham", "Other"];
---

<BaseLayout
  title="Sell Your Home for Top Dollar"
  description="Get top dollar for your home in Wellesley, Newton, Weston, Lexington, and surrounding Greater Boston areas. Free home valuation from Allison Murray, Realtor."
>
  <!-- Hero with multi-step valuation form -->
  <section class="sell-hero">
    <div class="sell-hero__media">
      <img src="/images/hero-sell.jpg" alt="A warmly lit home at dusk" fetchpriority="high" />
    </div>
    <div class="sell-hero__scrim"></div>
    <div class="container">
      <div class="sell-hero__grid">
        <div class="sell-hero__content">
          <span class="eyebrow">For Sellers</span>
          <h1>Sell for more.<br /><em class="accent-italic">Stress less.</em></h1>
          <p class="sell-hero__subtitle">
            As a Greater Boston &amp; MetroWest move-up and luxury home
            specialist, I help homeowners navigate the sale with confidence —
            and results that exceed expectations.
          </p>
          <ul class="sell-hero__checklist">
            <li>
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
              Free, no-obligation home valuation
            </li>
            <li>
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
              Personalized marketing strategy
            </li>
            <li>
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
              Expert negotiation for top dollar
            </li>
          </ul>
        </div>

        <div class="sell-hero__form-wrapper">
          <div class="val-form form-card">
            <div class="val-form__header">
              <h2>What's Your Home Worth?</h2>
              <p>Three quick steps. No obligation, ever.</p>
            </div>

            <div class="val-form__progress" aria-hidden="true">
              <div class="val-form__progress-bar" data-progress></div>
            </div>
            <div class="val-form__steps-label">
              <span data-step-label>Step 1 of 3 — Your Property</span>
            </div>

            <form action="https://formspree.io/f/YOUR_FORMSPREE_ID" method="POST" data-multistep>
              <input type="hidden" name="_subject" value="New Home Valuation Request from AllisonMurrayRealtor.com" />
              <input type="hidden" name="_next" value="/sell?success=true" />
              <input type="hidden" name="form_type" value="home_valuation" />

              <!-- Step 1: Address -->
              <fieldset class="val-form__step is-active" data-step="0">
                <div class="form__group">
                  <label for="address">Street Address</label>
                  <input type="text" id="address" name="address" placeholder="123 Main Street" required />
                </div>
                <div class="form__group">
                  <label for="town">Town</label>
                  <select id="town" name="town" required>
                    <option value="" disabled selected>Select your town</option>
                    {towns.map(t => <option value={t}>{t}</option>)}
                  </select>
                </div>
                <button type="button" class="btn btn--primary btn--large val-form__next" data-next-step>
                  Continue
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                </button>
              </fieldset>

              <!-- Step 2: Details -->
              <fieldset class="val-form__step" data-step="1">
                <div class="form__row">
                  <div class="form__group">
                    <label for="beds">Bedrooms</label>
                    <select id="beds" name="bedrooms">
                      <option value="" disabled selected>Select</option>
                      <option>1</option><option>2</option><option>3</option><option>4</option><option>5+</option>
                    </select>
                  </div>
                  <div class="form__group">
                    <label for="baths">Bathrooms</label>
                    <select id="baths" name="bathrooms">
                      <option value="" disabled selected>Select</option>
                      <option>1</option><option>1.5</option><option>2</option><option>2.5</option><option>3+</option>
                    </select>
                  </div>
                </div>
                <div class="form__group">
                  <label for="timeframe">When are you thinking of selling?</label>
                  <select id="timeframe" name="timeframe">
                    <option value="" disabled selected>Select a timeframe</option>
                    <option>As soon as possible</option>
                    <option>1–3 months</option>
                    <option>3–6 months</option>
                    <option>6–12 months</option>
                    <option>Just curious about value</option>
                  </select>
                </div>
                <div class="val-form__nav">
                  <button type="button" class="val-form__back" data-prev-step>
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
                    Back
                  </button>
                  <button type="button" class="btn btn--primary btn--large val-form__next" data-next-step>
                    Continue
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                  </button>
                </div>
              </fieldset>

              <!-- Step 3: Contact -->
              <fieldset class="val-form__step" data-step="2">
                <div class="form__group">
                  <label for="name">Your Name</label>
                  <input type="text" id="name" name="name" placeholder="Jane Smith" required />
                </div>
                <div class="form__group">
                  <label for="email">Email Address</label>
                  <input type="email" id="email" name="email" placeholder="jane@example.com" required />
                </div>
                <div class="form__group">
                  <label for="phone">Phone Number</label>
                  <input type="tel" id="phone" name="phone" placeholder="(555) 123-4567" />
                </div>
                <div class="val-form__nav">
                  <button type="button" class="val-form__back" data-prev-step>
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
                    Back
                  </button>
                  <button type="submit" class="btn btn--primary btn--large val-form__next">
                    Get My Free Valuation
                  </button>
                </div>
              </fieldset>

              <p class="form__disclaimer">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                Your information is secure and never shared. By submitting, you agree to be contacted about your home's value.
              </p>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Results / why list -->
  <section class="section section--white why">
    <div class="container">
      <div class="section__header animate-on-scroll">
        <span class="eyebrow eyebrow--center">Why List With Allison</span>
        <h2>A dedicated partner,<br /><em class="accent-italic">committed to your result</em></h2>
      </div>
      <div class="why__grid animate-stagger">
        <div class="why__card">
          <span class="why__number">01</span>
          <h3>Top Dollar Results</h3>
          <p>Strategic pricing and expert negotiation consistently achieve above-market sale prices for my clients.</p>
        </div>
        <div class="why__card">
          <span class="why__number">02</span>
          <h3>Faster Sales</h3>
          <p>Properly priced and marketed homes sell faster. My average days on market beats the local average.</p>
        </div>
        <div class="why__card">
          <span class="why__number">03</span>
          <h3>Buyer Network</h3>
          <p>Access to my network of pre-qualified buyers actively looking in your neighborhood right now.</p>
        </div>
        <div class="why__card">
          <span class="why__number">04</span>
          <h3>Stress-Free Experience</h3>
          <p>Every detail handled — from staging advice to closing coordination — so you can focus on what's next.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Marketing showcase -->
  <section class="section section--light showcase">
    <div class="container">
      <div class="section__header animate-on-scroll">
        <span class="eyebrow eyebrow--center">The Marketing</span>
        <h2>Your home, presented<br /><em class="accent-italic">at its absolute best</em></h2>
        <p class="section__subtitle">
          Professional photography, cinematic video, 3D tours, and targeted
          digital campaigns — plus syndication to the MLS and every major
          portal your buyers browse.
        </p>
      </div>
      <div class="showcase__grid animate-stagger">
        {marketing.map(item => (
          <figure class="showcase__item">
            <img src={item.image} alt={item.alt} loading="lazy" />
            <figcaption>{item.label}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- Process timeline -->
  <section class="section section--dark process">
    <div class="container container--narrow">
      <div class="section__header animate-on-scroll">
        <span class="eyebrow eyebrow--center">The Process</span>
        <h2>Five steps to sold</h2>
      </div>
      <div class="process__timeline">
        {sellingSteps.map(step => (
          <div class="process__step animate-on-scroll">
            <span class="process__number">{step.number}</span>
            <div class="process__content">
              <h3>{step.title}</h3>
              <p>{step.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section faq">
    <div class="container container--narrow">
      <div class="section__header animate-on-scroll">
        <span class="eyebrow eyebrow--center">Questions</span>
        <h2>Selling, answered</h2>
      </div>
      <div class="faq__list animate-stagger">
        {faqs.map((faq) => (
          <details class="faq__item">
            <summary class="faq__question">
              {faq.question}
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            </summary>
            <p class="faq__answer">{faq.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ Schema Markup -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map(faq => ({
      "@type": "Question",
      "name": faq.question,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": faq.answer
      }
    }))
  })} />

  <!-- CTA -->
  <section class="section section--dark cta">
    <div class="container">
      <div class="cta__content animate-on-scroll">
        <span class="eyebrow eyebrow--center">Ready When You Are</span>
        <h2>Find out what your<br /><em class="accent-italic">home is worth</em></h2>
        <p class="cta__text">
          A free, no-obligation valuation from a local expert who knows your
          neighborhood — often within 24 hours.
        </p>
        <div class="cta__buttons">
          <a href="#top-form" class="btn btn--primary btn--large" onclick="window.scrollTo({top: 0, behavior: 'smooth'}); return false;">
            Get My Free Valuation
          </a>
          <a href="tel:9788887649" class="btn btn--ghost btn--large">Call (978) 888-7649</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero */
  .sell-hero {
    position: relative;
    padding: calc(var(--header-height) + 4rem) 0 5rem;
    color: var(--paper);
    isolation: isolate;
    overflow: hidden;
  }

  .sell-hero__media {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  .sell-hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .sell-hero__scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(105deg, rgba(22, 19, 15, 0.88) 0%, rgba(22, 19, 15, 0.6) 55%, rgba(22, 19, 15, 0.45) 100%);
  }

  .sell-hero__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: center;
  }

  .sell-hero h1 {
    color: var(--paper);
  }

  .sell-hero .eyebrow {
    color: var(--bronze-pale);
  }

  .sell-hero .eyebrow::before {
    background-color: var(--bronze-pale);
  }

  .sell-hero__subtitle {
    font-size: 1.125rem;
    line-height: 1.8;
    color: rgba(250, 248, 244, 0.85);
    margin-bottom: var(--spacing-lg);
  }

  .sell-hero__checklist {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
  }

  .sell-hero__checklist li {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    font-size: 1rem;
    color: rgba(250, 248, 244, 0.9);
  }

  .sell-hero__checklist svg {
    color: var(--bronze-pale);
    flex-shrink: 0;
  }

  /* Multi-step valuation form */
  .val-form {
    background-color: var(--paper);
    border-radius: var(--radius-lg);
    padding: clamp(1.75rem, 4vw, 2.5rem);
    color: var(--ink-soft);
    box-shadow: var(--shadow-xl);
  }

  .val-form__header h2 {
    font-size: 1.75rem;
    margin-bottom: 0.25rem;
  }

  .val-form__header p {
    color: var(--ink-mute);
    font-size: 0.9375rem;
    margin-bottom: var(--spacing-md);
  }

  .val-form__progress {
    height: 3px;
    background-color: var(--linen);
    border-radius: 2px;
    overflow: hidden;
    margin-bottom: 0.625rem;
  }

  .val-form__progress-bar {
    height: 100%;
    width: 33.33%;
    background-color: var(--bronze);
    transition: width 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .val-form__steps-label {
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--bronze);
    margin-bottom: var(--spacing-md);
  }

  .val-form__step {
    display: none;
    border: none;
  }

  .val-form__step.is-active {
    display: block;
    animation: stepIn 0.35s ease;
  }

  @keyframes stepIn {
    from { opacity: 0; transform: translateX(16px); }
    to { opacity: 1; transform: translateX(0); }
  }

  .val-form__next {
    width: 100%;
  }

  .val-form__nav {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
  }

  .val-form__nav .val-form__next {
    flex: 1;
  }

  .val-form__back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 1rem 1.25rem;
    background: none;
    border: none;
    cursor: pointer;
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--ink-mute);
    transition: color var(--transition-fast);
  }

  .val-form__back:hover {
    color: var(--ink);
  }

  /* Why cards */
  .why__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--spacing-lg);
  }

  .why__card {
    padding-top: var(--spacing-md);
    border-top: 1px solid var(--hairline);
  }

  .why__number {
    display: block;
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-style: italic;
    color: var(--bronze);
    margin-bottom: var(--spacing-sm);
  }

  .why__card h3 {
    font-size: 1.375rem;
    margin-bottom: var(--spacing-xs);
  }

  .why__card p {
    font-size: 0.9375rem;
    line-height: 1.75;
    color: var(--ink-mute);
    margin-bottom: 0;
  }

  /* Marketing showcase */
  .showcase__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--spacing-md);
  }

  .showcase__item {
    position: relative;
    aspect-ratio: 3/4;
    overflow: hidden;
    border-radius: var(--radius-md);
    isolation: isolate;
  }

  .showcase__item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .showcase__item:hover img {
    transform: scale(1.05);
  }

  .showcase__item::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(22, 19, 15, 0.72) 0%, transparent 45%);
  }

  .showcase__item figcaption {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 1;
    padding: var(--spacing-md);
    color: var(--paper);
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.16em;
  }

  /* Process timeline */
  .process__timeline {
    display: flex;
    flex-direction: column;
  }

  .process__step {
    display: flex;
    gap: var(--spacing-xl);
    padding: var(--spacing-lg) 0;
    border-bottom: 1px solid var(--hairline-light);
  }

  .process__step:last-child {
    border-bottom: none;
  }

  .process__number {
    font-family: var(--font-display);
    font-size: 2.25rem;
    font-style: italic;
    color: var(--bronze-pale);
    flex-shrink: 0;
    width: 72px;
    line-height: 1;
  }

  .process__content h3 {
    font-size: 1.5rem;
    margin-bottom: var(--spacing-xs);
  }

  .process__content p {
    color: rgba(250, 248, 244, 0.65);
    margin-bottom: 0;
    font-size: 0.9875rem;
    line-height: 1.8;
  }

  /* FAQ */
  .faq__list {
    display: flex;
    flex-direction: column;
  }

  .faq__item {
    border-bottom: 1px solid var(--hairline);
  }

  .faq__question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-md);
    padding: var(--spacing-md) 0;
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 500;
    color: var(--ink);
    cursor: pointer;
    list-style: none;
    transition: color var(--transition-fast);
  }

  .faq__question::-webkit-details-marker {
    display: none;
  }

  .faq__question:hover {
    color: var(--bronze);
  }

  .faq__question svg {
    flex-shrink: 0;
    color: var(--bronze);
    transition: transform 0.3s ease;
  }

  .faq__item[open] .faq__question svg {
    transform: rotate(45deg);
  }

  .faq__answer {
    color: var(--ink-mute);
    line-height: 1.8;
    padding-bottom: var(--spacing-md);
    margin-bottom: 0;
    max-width: 720px;
  }

  /* CTA */
  .cta__content {
    text-align: center;
    max-width: 720px;
    margin: 0 auto;
  }

  .cta__content .eyebrow {
    justify-content: center;
  }

  .cta__text {
    font-size: 1.125rem;
    color: rgba(250, 248, 244, 0.72);
    margin-bottom: var(--spacing-xl);
  }

  .cta__buttons {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--spacing-sm);
  }

  /* Responsive */
  @media (max-width: 1000px) {
    .sell-hero__grid {
      grid-template-columns: 1fr;
    }

    .sell-hero__content {
      text-align: center;
    }

    .sell-hero .eyebrow {
      justify-content: center;
    }

    .sell-hero .eyebrow::after {
      content: '';
