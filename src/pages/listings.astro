---
import BaseLayout from '../layouts/BaseLayout.astro';

const recentlySold = [
  {
    address: "Beautiful Colonial",
    location: "Wellesley, MA",
    price: "$1,425,000",
    image: "/images/town-needham.jpg",
    beds: 4,
    baths: 3.5,
    sqft: "3,200",
    status: "Sold Over Asking"
  },
  {
    address: "Charming Cape",
    location: "Newton, MA",
    price: "$985,000",
    image: "/images/town-lexington.jpg",
    beds: 3,
    baths: 2,
    sqft: "2,100",
    status: "Sold in 5 Days"
  },
  {
    address: "Modern Ranch",
    location: "Needham, MA",
    price: "$1,150,000",
    image: "/images/town-wellesley.jpg",
    beds: 4,
    baths: 2.5,
    sqft: "2,800",
    status: "Multiple Offers"
  },
  {
    address: "Victorian Gem",
    location: "Lexington, MA",
    price: "$1,675,000",
    image: "/images/town-newton.jpg",
    beds: 5,
    baths: 4,
    sqft: "4,100",
    status: "Sold Over Asking"
  }
];

const areas = [
  { name: "Wellesley", slug: "wellesley", desc: "Premier suburban living" },
  { name: "Weston", slug: "weston", desc: "Exclusive estates" },
  { name: "Newton", slug: "newton", desc: "13 unique villages" },
  { name: "Lexington", slug: "lexington", desc: "Historic character" },
  { name: "Needham", slug: "needham", desc: "Family-friendly" },
  { name: "Natick", slug: "natick", desc: "Growing hub" },
  { name: "Waltham", slug: "waltham", desc: "Urban energy" },
];
---

<BaseLayout
  title="Listings"
  description="View current listings from Allison Murray, Realtor. Homes for sale in Wellesley, Newton, Weston, Lexington, Needham, Natick, and Waltham MA."
>
  <!-- Hero -->
  <section class="page-hero page-hero--short">
    <div class="page-hero__media">
      <img src="/images/hero-sell.jpg" alt="A warmly lit home at dusk" fetchpriority="high" />
    </div>
    <div class="page-hero__scrim"></div>
    <div class="container">
      <span class="eyebrow">Featured Properties</span>
      <h1>Current &amp; recent<br /><em class="accent-italic">listings</em></h1>
      <p class="page-hero__lead">
        Browse my current listings and recently sold properties across Greater
        Boston's premier communities.
      </p>
    </div>
  </section>

  <!-- Current listings -->
  <section class="section section--white current">
    <div class="container container--narrow">
      <div class="current__card animate-scale">
        <span class="eyebrow eyebrow--plain">Live Inventory</span>
        <h2>View All Current Listings</h2>
        <p>
          For the most up-to-date listings and property details — including
          photos, virtual tours, and full property information — visit my
          profile on the Chinatti Realty Group website.
        </p>
        <a
          href="https://www.chinattirealty.com/agents/allison-murray/"
          target="_blank"
          rel="noopener"
          class="btn btn--primary btn--large"
        >
          View Listings on Chinatti Realty
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
            <polyline points="15 3 21 3 21 9"></polyline>
            <line x1="10" y1="14" x2="21" y2="3"></line>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Recently sold -->
  <section class="section section--light sold">
    <div class="container">
      <div class="section__header animate-on-scroll">
        <span class="eyebrow eyebrow--center">Recently Sold</span>
        <h2>A sample of recent<br /><em class="accent-italic">successful sales</em></h2>
      </div>
      <div class="sold__grid animate-stagger">
        {recentlySold.map(property => (
          <div class="sold__card">
            <div class="sold__image">
              <img src={property.image} alt={`${property.address} — ${property.location}`} loading="lazy" />
              <span class="sold__badge">{property.status}</span>
            </div>
            <div class="sold__content">
              <span class="sold__price">{property.price}</span>
              <h3 class="sold__address">{property.address}</h3>
              <span class="sold__location">{property.location}</span>
              <div class="sold__details">
                <span>{property.beds} bed</span>
                <span class="sold__dot" aria-hidden="true"></span>
                <span>{property.baths} bath</span>
                <span class="sold__dot" aria-hidden="true"></span>
                <span>{property.sqft} sqft</span>
              </div>
            </div>
          </div>
        ))}
      </div>
      <p class="sold__note animate-fade">Representative of recent transactions. Details available on request.</p>
    </div>
  </section>

  <!-- Communities -->
  <section class="section specialize">
    <div class="container">
      <div class="section__header animate-on-scroll">
        <span class="eyebrow eyebrow--center">Communities</span>
        <h2>Where I specialize</h2>
      </div>
      <div class="specialize__grid animate-stagger">
        {areas.map(area => (
          <a href={`/areas/${area.slug}`} class="specialize__card">
            <span class="specialize__name">{area.name}</span>
            <span class="specialize__desc">{area.desc}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Thinking of selling -->
  <section class="section section--dark cta">
    <div class="container">
      <div class="cta__content animate-on-scroll">
        <span class="eyebrow eyebrow--center">Thinking of Selling?</span>
        <h2>Your home could be<br /><em class="accent-italic">the next success story</em></h2>
        <p class="cta__text">
          Get a complimentary market analysis — see what similar homes are
          selling for and understand your options.
        </p>
        <div class="cta__buttons">
          <a href="/sell" class="btn btn--primary btn--large">Get Your Free Home Valuation</a>
          <a href="tel:9788887649" class="btn btn--ghost btn--large">Call (978) 888-7649</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero--short {
    min-height: 52vh;
  }

  /* Current listings card */
  .current__card {
    text-align: center;
    padding: clamp(2rem, 5vw, 3.5rem);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-md);
    background-color: var(--paper);
  }

  .current__card p {
    max-width: 560px;
    margin: 0 auto var(--spacing-lg);
    color: var(--ink-mute);
  }

  /* Sold grid */
  .sold__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--spacing-md);
  }

  .sold__card {
    background-color: var(--white);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: box-shadow var(--transition-base), transform var(--transition-base);
  }

  .sold__card:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-4px);
  }

  .sold__image {
    position: relative;
    aspect-ratio: 4/3;
    overflow: hidden;
  }

  .sold__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.9s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .sold__card:hover .sold__image img {
    transform: scale(1.06);
  }

  .sold__badge {
    position: absolute;
    top: 0.875rem;
    left: 0.875rem;
    padding: 0.375rem 0.75rem;
    background-color: var(--ink);
    color: var(--paper);
    font-size: 0.625rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    border-radius: var(--radius-sm);
  }

  .sold__content {
    padding: var(--spacing-md);
  }

  .sold__price {
    display: block;
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 500;
    color: var(--ink);
    margin-bottom: 0.125rem;
  }

  .sold__address {
    font-size: 1.0625rem;
    font-family: var(--font-body);
    font-weight: 600;
    margin-bottom: 0.125rem;
  }

  .sold__location {
    display: block;
    font-size: 0.8125rem;
    color: var(--ink-mute);
    margin-bottom: var(--spacing-sm);
  }

  .sold__details {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-size: 0.8125rem;
    color: var(--ink-mute);
    padding-top: var(--spacing-sm);
    border-top: 1px solid var(--hairline);
  }

  .sold__dot {
    width: 3px;
    height: 3px;
    background-color: var(--bronze);
    border-radius: 50%;
  }

  .sold__note {
    text-align: center;
    font-size: 0.8125rem;
    color: var(--ink-mute);
    margin: var(--spacing-lg) 0 0;
  }

  /* Specialize */
  .specialize__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--spacing-md);
  }

  .specialize__card {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: var(--spacing-md);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-md);
    transition: all var(--transition-base);
  }

  .specialize__card:hover {
    border-color: var(--bronze);
    box-shadow: var(--shadow-sm);
    transform: translateY(-2px);
  }

  .specialize__name {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 500;
    color: var(--ink);
  }

  .specialize__desc {
    font-size: 0.8125rem;
    color: var(--ink-mute);
  }

  /* CTA */
  .cta__content {
    text-align: center;
    max-width: 720px;
    margin: 0 auto;
  }

  .cta__text {
    font-size: 1.125rem;
    color: rgba(250, 248, 244, 0.72);
    margin-bottom: var(--spacing-xl);
  }

  .cta__buttons {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--spacing-sm);
  }

  @media (max-width: 1000px) {
    .sold__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .sold__grid {
      grid-template-columns: 1fr;
    }

    .cta__buttons {
      flex-direction: column;
      align-items: center;
    }
  }
</style>
