---
import BaseLayout from '../../layouts/BaseLayout.astro';

const serviceAreas = [
  {
    name: "Wellesley",
    slug: "wellesley",
    tagline: "Premier Suburban Living with Top-Rated Schools",
    description: "Known for its exceptional schools, beautiful tree-lined streets, and easy commute to Boston. Wellesley offers the perfect blend of suburban tranquility and urban accessibility.",
    highlights: ["Top-rated public schools", "Wellesley College", "Charles River access", "Vibrant downtown"]
  },
  {
    name: "Weston",
    slug: "weston",
    tagline: "Exclusive Estates and Natural Beauty",
    description: "One of the most prestigious communities in Greater Boston, Weston features expansive properties, conservation land, and a commitment to preserving its natural character.",
    highlights: ["Large estate properties", "Conservation land", "Excellent schools", "Country club living"]
  },
  {
    name: "Newton",
    slug: "newton",
    tagline: "Village Charm Meets Urban Convenience",
    description: "With 13 distinct villages, Newton offers diverse housing options from historic Victorians to modern new construction. Excellent transit access to Boston.",
    highlights: ["13 unique villages", "T access to Boston", "Top-rated schools", "Crystal Lake recreation"]
  },
  {
    name: "Lexington",
    slug: "lexington",
    tagline: "Historic Character with Modern Amenities",
    description: "Birthplace of American liberty, Lexington combines rich history with excellent schools and a strong sense of community.",
    highlights: ["Revolutionary War history", "Outstanding schools", "Minuteman Bikeway", "Strong community events"]
  },
  {
    name: "Needham",
    slug: "needham",
    tagline: "Family-Friendly with Excellent Community",
    description: "A welcoming community known for its strong schools, beautiful parks, and active downtown. Great value compared to neighboring towns.",
    highlights: ["Award-winning schools", "Downtown Needham shops", "Charles River access", "Family-oriented"]
  },
  {
    name: "Natick",
    slug: "natick",
    tagline: "Growing Hub with Great Accessibility",
    description: "A dynamic community with excellent shopping, diverse housing, and easy access to Route 9 and the Mass Pike. Growing downtown with new restaurants and shops.",
    highlights: ["Natick Mall area", "Lake Cochituate", "Commuter rail access", "Growing downtown"]
  },
  {
    name: "Waltham",
    slug: "waltham",
    tagline: "Diverse Community with Urban Energy",
    description: "Home to Brandeis University and a thriving restaurant scene on Moody Street. Waltham offers diverse housing options at accessible price points.",
    highlights: ["Brandeis University", "Moody Street dining", "Historic Watch City", "Accessible prices"]
  }
];
---

<BaseLayout
  title="Communities We Serve"
  description="Allison Murray serves Wellesley, Weston, Newton, Lexington, Needham, Natick, and Waltham MA. Expert real estate services in Greater Boston's premier communities."
>
  <!-- Hero -->
  <section class="page-hero page-hero--short">
    <div class="page-hero__media">
      <img src="/images/town-weston.jpg" alt="A grand stone home surrounded by trees" fetchpriority="high" />
    </div>
    <div class="page-hero__scrim"></div>
    <div class="container">
      <span class="eyebrow">Communities</span>
      <h1>Greater Boston's<br /><em class="accent-italic">premier communities</em></h1>
      <p class="page-hero__lead">
        Deep local knowledge in the neighborhoods you care about most. I live
        and work in these communities and understand what makes each one special.
      </p>
    </div>
  </section>

  <!-- Areas -->
  <section class="section areas">
    <div class="container">
      <div class="areas__grid">
        {serviceAreas.map((area, i) => (
          <a href={`/areas/${area.slug}`} class:list={['area-card', 'animate-on-scroll', { 'area-card--wide': i === 0 }]}>
            <div class="area-card__image">
              <img src={`/images/town-${area.slug}.jpg`} alt={`Homes in ${area.name}, Massachusetts`} loading={i < 2 ? 'eager' : 'lazy'} />
            </div>
            <div class="area-card__body">
              <h2 class="area-card__name">{area.name}</h2>
              <span class="area-card__tagline">{area.tagline}</span>
              <p class="area-card__description">{area.description}</p>
              <ul class="area-card__highlights">
                {area.highlights.map(highlight => (
                  <li>
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                    {highlight}
                  </li>
                ))}
              </ul>
              <span class="area-card__link">
                View {area.name} Guide
                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section section--dark cta">
    <div class="container">
      <div class="cta__content animate-on-scroll">
        <span class="eyebrow eyebrow--center">Local Expertise</span>
        <h2>Looking to buy or sell<br /><em class="accent-italic">in these areas?</em></h2>
        <p class="cta__text">
          Let's discuss your real estate goals. I'd love to share my local
          knowledge and help you make the best decision for your family.
        </p>
        <div class="cta__buttons">
          <a href="/sell" class="btn btn--primary btn--large">Get Your Free Home Valuation</a>
          <a href="tel:9788887649" class="btn btn--ghost btn--large">Call (978) 888-7649</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero--short {
    min-height: 52vh;
  }

  .areas__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--spacing-lg);
  }

  .area-card {
    display: flex;
    flex-direction: column;
    background-color: var(--white);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: box-shadow var(--transition-base), transform var(--transition-base);
  }

  .area-card:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-4px);
  }

  .area-card__image {
    aspect-ratio: 16/9;
    overflow: hidden;
  }

  .area-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.9s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .area-card:hover .area-card__image img {
    transform: scale(1.05);
  }

  .area-card__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: var(--spacing-lg);
  }

  .area-card__name {
    font-size: 1.875rem;
    margin-bottom: 0.25rem;
  }

  .area-card__tagline {
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--bronze);
    margin-bottom: var(--spacing-sm);
  }

  .area-card__description {
    color: var(--ink-mute);
    font-size: 0.9375rem;
    line-height: 1.75;
    margin-bottom: var(--spacing-md);
  }

  .area-card__highlights {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem var(--spacing-sm);
    margin-bottom: var(--spacing-md);
  }

  .area-card__highlights li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: var(--ink-soft);
  }

  .area-card__highlights svg {
    color: var(--bronze);
    flex-shrink: 0;
  }

  .area-card__link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: auto;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--ink);
  }

  .area-card__link svg {
    color: var(--bronze);
    transition: transform var(--transition-base);
  }

  .area-card:hover .area-card__link svg {
    transform: translateX(4px);
  }

  /* CTA */
  .cta__content {
    text-align: center;
    max-width: 720px;
    margin: 0 auto;
  }

  .cta__text {
    font-size: 1.125rem;
    color: rgba(250, 248, 244, 0.72);
    margin-bottom: var(--spacing-xl);
  }

  .cta__buttons {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--spacing-sm);
  }

  @media (max-width: 800px) {
    .areas__grid {
      grid-template-columns: 1fr;
    }

    .area-card__highlights {
      grid-template-columns: 1fr;
    }

    .cta__buttons {
      flex-direction: column;
      align-items: center;
    }
  }
</style>
