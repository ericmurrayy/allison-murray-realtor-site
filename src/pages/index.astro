---
import BaseLayout from '../layouts/BaseLayout.astro';

const testimonials = [
  {
    quote: "Allison sold our Wellesley home for $87,000 OVER asking in just 6 days! Her pricing strategy and marketing brought in 12 offers. We couldn't believe it.",
    author: "The Richardson Family",
    location: "Sold in Wellesley, MA",
    result: "$87K over asking"
  },
  {
    quote: "In this competitive market, Allison got our offer accepted on the first home we loved. Her negotiation saved us $40K and we closed in 30 days.",
    author: "Sarah & David M.",
    location: "Bought in Newton, MA",
    result: "Won in a bidding war"
  },
  {
    quote: "We interviewed 5 agents. Allison was the only one who gave us honest feedback about pricing. She was right—we sold for $52K more than the others suggested.",
    author: "The Chen Family",
    location: "Sold in Lexington, MA",
    result: "$52K more than expected"
  }
];

const stats = [
  { value: 100, suffix: "+", label: "Homes Sold" },
  { value: 50, prefix: "$", suffix: "M+", label: "In Sales Volume" },
  { value: 15, suffix: "+", label: "Years of Experience" },
  { value: 5, suffix: ".0", label: "Client Rating" }
];

const serviceAreas = [
  { name: "Wellesley", slug: "wellesley", image: "/images/town-wellesley.jpg", description: "Premier suburban living with top-rated schools" },
  { name: "Weston", slug: "weston", image: "/images/town-weston.jpg", description: "Exclusive estates and natural beauty" },
  { name: "Newton", slug: "newton", image: "/images/town-newton.jpg", description: "Village charm meets urban convenience" },
  { name: "Lexington", slug: "lexington", image: "/images/town-lexington.jpg", description: "Historic character with modern amenities" },
  { name: "Needham", slug: "needham", image: "/images/town-needham.jpg", description: "Family-friendly with excellent community" },
  { name: "Natick", slug: "natick", image: "/images/town-natick.jpg", description: "Growing hub with great accessibility" },
];

const process = [
  { number: "01", title: "Strategy & Pricing", description: "A data-driven market analysis and pricing strategy built around your home, your timeline, and your goals." },
  { number: "02", title: "Preparation & Marketing", description: "Staging guidance, professional photography, and targeted digital marketing that makes your home impossible to miss." },
  { number: "03", title: "Negotiation & Close", description: "Skilled negotiation through offers, inspection, and appraisal — protecting every dollar to the closing table." },
];
---

<BaseLayout
  title="Greater Boston & MetroWest Real Estate"
  description="Allison Murray helps homeowners sell for top dollar and buyers find their dream homes in Wellesley, Newton, Weston, Lexington, Needham, Natick & Waltham MA."
>
  <!-- Hero -->
  <section class="hero">
    <div class="hero__media">
      <img src="/images/hero-home.jpg" alt="A classic New England home with a wraparound porch" fetchpriority="high" />
    </div>
    <div class="hero__scrim"></div>
    <div class="container hero__container">
      <div class="hero__content">
        <span class="hero__eyebrow">Wellesley &middot; Weston &middot; Newton &middot; Greater Boston</span>
        <h1 class="hero__title">
          Selling homes is my craft.<br />
          <em>Your move is my mission.</em>
        </h1>
        <p class="hero__subtitle">
          Allison Murray pairs deep MetroWest expertise with concierge-level
          service — helping sellers command top dollar and buyers win the
          homes they love.
        </p>
        <div class="hero__ctas">
          <a href="/sell" class="btn btn--primary btn--large">What's Your Home Worth?</a>
          <a href="/areas" class="btn btn--ghost btn--large">Explore Communities</a>
        </div>
      </div>
    </div>
    <a href="#stats" class="hero__scroll" aria-label="Scroll to content">
      <span></span>
    </a>
  </section>

  <!-- Stats -->
  <section class="stats" id="stats">
    <div class="container">
      <div class="stats__grid">
        {stats.map(stat => (
          <div class="stats__item">
            <span
              class="stats__number"
              data-count={stat.value}
              data-prefix={stat.prefix || ''}
              data-suffix={stat.suffix || ''}
            >{(stat.prefix || '') + stat.value + (stat.suffix || '')}</span>
            <span class="stats__label">{stat.label}</span>
          </div>
        ))}
      </div>
      <div class="stats__credentials">
        <span>Licensed MA Real Estate Agent</span>
        <span class="stats__dot" aria-hidden="true"></span>
        <span>Chinatti Realty Group</span>
        <span class="stats__dot" aria-hidden="true"></span>
        <span>REALTOR&reg; &middot; NAR Member</span>
        <span class="stats__dot" aria-hidden="true"></span>
        <span>Equal Housing Opportunity</span>
      </div>
    </div>
  </section>

  <!-- Dual pathways -->
  <section class="paths">
    <a href="/sell" class="paths__panel">
      <img src="/images/hero-sell.jpg" alt="A warmly lit home at dusk" loading="lazy" />
      <div class="paths__overlay"></div>
      <div class="paths__content">
        <span class="paths__eyebrow">For Sellers</span>
        <h2 class="paths__title">Sell for Top Dollar</h2>
        <p class="paths__text">Strategic pricing, striking marketing, and expert negotiation — discover what your home could sell for in today's market.</p>
        <span class="paths__link">
          Get Your Free Valuation
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
        </span>
      </div>
    </a>
    <a href="/buy" class="paths__panel">
      <img src="/images/hero-buy.jpg" alt="A sunny neighborhood street with classic homes" loading="lazy" />
      <div class="paths__overlay"></div>
      <div class="paths__content">
        <span class="paths__eyebrow">For Buyers</span>
        <h2 class="paths__title">Find Your Next Home</h2>
        <p class="paths__text">From first showings to winning offers — navigate Greater Boston's competitive market with a local expert at your side.</p>
        <span class="paths__link">
          Start Your Search
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
        </span>
      </div>
    </a>
  </section>

  <!-- Meet Allison -->
  <section class="section section--white meet">
    <div class="container">
      <div class="meet__grid">
        <div class="meet__image animate-slide-left">
          <div class="meet__image-frame">
            <img
              src="/allison-headshot.jpg"
              alt="Allison Murray, Greater Boston Realtor"
              loading="lazy"
              onerror="this.src='/headshot-placeholder.svg'"
            />
          </div>
        </div>
        <div class="meet__content animate-slide-right">
          <span class="eyebrow">Meet Allison</span>
          <h2>A neighbor first.<br /><em class="accent-italic">An expert always.</em></h2>
          <p class="meet__lead">
            I grew up in the Boston area and know these neighborhoods inside
            and out — the streets, the schools, the markets, and what it
            actually takes to win here.
          </p>
          <p>
            Real estate isn't just my career, it's my passion. There's nothing
            more rewarding than handing keys to a family who just found their
            forever home, or seeing the relief on a seller's face when we
            close above asking. When you work with me, you get a dedicated
            partner who treats your move like it's her own.
          </p>
          <blockquote class="meet__quote">
            &ldquo;Every home has a story. My job is to make sure yours ends
            with the best possible next chapter.&rdquo;
          </blockquote>
          <div class="meet__ctas">
            <a href="/about" class="btn btn--dark">More About Allison</a>
            <a href="/contact" class="text-link">
              Let's Talk
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Video introduction -->
  <section class="section section--light intro">
    <div class="container">
      <div class="intro__grid">
        <div class="intro__video animate-fade">
          <div class="intro__video-wrapper">
            <iframe
              src="https://www.youtube.com/embed/YFPxgPTD2Fk?rel=0&modestbranding=1&playsinline=1&autoplay=0"
              title="Meet Allison Murray - Your Greater Boston Realtor"
              frameborder="0"
              allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              allowfullscreen
            ></iframe>
          </div>
        </div>
        <div class="intro__content animate-slide-right">
          <span class="eyebrow">A Personal Note</span>
          <h2>Hi, I'm Allison</h2>
          <p class="intro__lead">
            Before we ever talk numbers, I'd love for you to know who you'll
            be working with. Take a minute to say hello — then let's talk
            about your goals.
          </p>
          <p>
            Whether you're three weeks or three years from making a move,
            I'm happy to be a resource. No pressure, no obligation — just
            honest local advice.
          </p>
          <div class="intro__ctas">
            <a href="/contact" class="btn btn--primary">Say Hello</a>
            <a href="tel:9788887649" class="btn btn--secondary">Call (978) 888-7649</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="section section--dark process">
    <div class="container">
      <div class="section__header animate-on-scroll">
        <span class="eyebrow eyebrow--center">The Approach</span>
        <h2>Top dollar isn't luck.<br />It's a process.</h2>
      </div>
      <div class="process__grid animate-stagger">
        {process.map(step => (
          <div class="process__step">
            <span class="process__number">{step.number}</span>
            <h3>{step.title}</h3>
            <p>{step.description}</p>
          </div>
        ))}
      </div>
      <div class="process__cta animate-fade">
        <a href="/sell" class="btn btn--primary btn--large">See the Full Selling Process</a>
      </div>
    </div>
  </section>

  <!-- Communities -->
  <section class="section areas">
    <div class="container">
      <div class="section__header animate-on-scroll">
        <span class="eyebrow eyebrow--center">Where I Work</span>
        <h2>Greater Boston's most<br /><em class="accent-italic">sought-after communities</em></h2>
      </div>

      <div class="areas__grid animate-stagger">
        {serviceAreas.map(area => (
          <a href={`/areas/${area.slug}`} class="areas__card">
            <div class="areas__image">
              <img src={area.image} alt={`Homes in ${area.name}, Massachusetts`} loading="lazy" />
            </div>
            <div class="areas__overlay"></div>
            <div class="areas__body">
              <h3 class="areas__name">{area.name}</h3>
              <p class="areas__description">{area.description}</p>
              <span class="areas__link">
                Explore
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
              </span>
            </div>
          </a>
        ))}
      </div>

      <div class="areas__more animate-fade">
        <p>Also serving <a href="/areas/waltham">Waltham</a> and surrounding towns</p>
        <a href="/areas" class="text-link">
          View All Communities
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Testimonials carousel -->
  <section class="section section--white testimonials">
    <div class="container container--narrow">
      <div class="section__header animate-on-scroll">
        <span class="eyebrow eyebrow--center">Client Stories</span>
        <h2>Results that speak<br /><em class="accent-italic">for themselves</em></h2>
      </div>

      <div class="carousel animate-fade" data-carousel>
        <div class="carousel__track">
          {testimonials.map((t, i) => (
            <figure class:list={['carousel__slide', { 'is-active': i === 0 }]} data-slide={i}>
              <div class="carousel__stars" aria-label="5 star review">
                {Array.from({ length: 5 }).map(() => (
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                ))}
              </div>
              <blockquote class="carousel__quote">&ldquo;{t.quote}&rdquo;</blockquote>
              <figcaption class="carousel__author">
                <span class="carousel__name">{t.author}</span>
                <span class="carousel__meta">{t.location} &middot; {t.result}</span>
              </figcaption>
            </figure>
          ))}
        </div>
        <div class="carousel__controls">
          <button class="carousel__arrow" data-prev aria-label="Previous testimonial">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
          </button>
          <div class="carousel__dots">
            {testimonials.map((_, i) => (
              <button class:list={['carousel__dot', { 'is-active': i === 0 }]} data-dot={i} aria-label={`Go to testimonial ${i + 1}`}></button>
            ))}
          </div>
          <button class="carousel__arrow" data-next aria-label="Next testimonial">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </button>
        </div>
        <div class="carousel__footer">
          <a href="/reviews" class="text-link">
            Read All Reviews
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Work with Allison — final CTA + form -->
  <section class="connect" id="connect">
    <div class="connect__media">
      <img src="/images/autumn-lake.jpg" alt="New England fall foliage reflected in a lake" loading="lazy" />
    </div>
    <div class="connect__scrim"></div>
    <div class="container connect__container">
      <div class="connect__content animate-slide-left">
        <span class="eyebrow">Work With Allison</span>
        <h2>Let's talk about<br /><em class="accent-italic">your next move</em></h2>
        <p class="connect__text">
          Whether you're selling, buying, or simply curious about the market,
          the first conversation is free — and always pressure-free.
        </p>
        <a href="tel:9788887649" class="connect__phone">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
          (978) 888-7649
        </a>
      </div>
      <div class="connect__form-wrapper animate-slide-right">
        <div class="connect__form form-card">
          <h3>Send a Message</h3>
          <form action="https://formspree.io/f/YOUR_FORMSPREE_ID" method="POST">
            <input type="hidden" name="_subject" value="New Contact from AllisonMurrayRealtor.com (Homepage)" />
            <input type="hidden" name="_next" value="/contact?success=true" />
            <input type="hidden" name="form_type" value="homepage_contact" />
            <div class="form__group">
              <label for="hc-name">Name</label>
              <input type="text" id="hc-name" name="name" placeholder="Your name" required />
            </div>
            <div class="form__row">
              <div class="form__group">
                <label for="hc-email">Email</label>
                <input type="email" id="hc-email" name="email" placeholder="you@example.com" required />
              </div>
              <div class="form__group">
                <label for="hc-phone">Phone</label>
                <input type="tel" id="hc-phone" name="phone" placeholder="(555) 123-4567" />
              </div>
            </div>
            <div class="form__group">
              <label for="hc-message">How can I help?</label>
              <textarea id="hc-message" name="message" rows="3" placeholder="I'm thinking about selling my home in..."></textarea>
            </div>
            <button type="submit" class="btn btn--primary btn--large connect__submit">Send Message</button>
            <p class="form__disclaimer">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
              Your information is secure and never shared. By submitting, you agree to be contacted about your inquiry.
            </p>
          </form>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero */
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    color: var(--paper);
    isolation: isolate;
    overflow: hidden;
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  .hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    animation: heroZoom 18s ease-out forwards;
  }

  @keyframes heroZoom {
    from { transform: scale(1.08); }
    to { transform: scale(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__media img { animation: none; }
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      to bottom,
      rgba(22, 19, 15, 0.5) 0%,
      rgba(22, 19, 15, 0.28) 40%,
      rgba(22, 19, 15, 0.72) 100%
    );
  }

  .hero__content {
    max-width: 780px;
    padding: calc(var(--header-height) + 2rem) 0 5rem;
  }

  .hero__eyebrow {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.3em;
    color: var(--bronze-pale);
    margin-bottom: var(--spacing-md);
    animation: revealUp 0.9s cubic-bezier(0.22, 1, 0.36, 1) 0.2s both;
  }

  .hero__title {
    color: var(--paper);
    margin-bottom: var(--spacing-md);
    animation: revealUp 0.9s cubic-bezier(0.22, 1, 0.36, 1) 0.35s both;
  }

  .hero__title em {
    color: var(--bronze-pale);
  }

  .hero__subtitle {
    font-size: 1.1875rem;
    line-height: 1.8;
    color: rgba(250, 248, 244, 0.88);
    max-width: 560px;
    margin-bottom: var(--spacing-xl);
    animation: revealUp 0.9s cubic-bezier(0.22, 1, 0.36, 1) 0.5s both;
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-sm);
    animation: revealUp 0.9s cubic-bezier(0.22, 1, 0.36, 1) 0.65s both;
  }

  .hero__scroll {
    position: absolute;
    bottom: 2.25rem;
    left: 50%;
    transform: translateX(-50%);
    width: 26px;
    height: 42px;
    border: 1.5px solid rgba(250, 248, 244, 0.5);
    border-radius: 13px;
    display: flex;
    justify-content: center;
    padding-top: 8px;
    animation: revealFade 1s ease 1.2s both;
  }

  .hero__scroll span {
    width: 2px;
    height: 8px;
    background-color: rgba(250, 248, 244, 0.8);
    border-radius: 1px;
    animation: scrollHint 2s ease-in-out infinite;
  }

  @keyframes scrollHint {
    0%, 100% { transform: translateY(0); opacity: 1; }
    50% { transform: translateY(10px); opacity: 0.3; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__eyebrow, .hero__title, .hero__subtitle, .hero__ctas, .hero__scroll {
      animation: none;
    }
    .hero__scroll span { animation: none; }
  }

  /* Stats */
  .stats {
    background-color: var(--paper);
    padding: var(--spacing-2xl) 0 var(--spacing-xl);
    border-bottom: 1px solid var(--hairline);
  }

  .stats__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--spacing-lg);
    text-align: center;
    margin-bottom: var(--spacing-xl);
  }

  .stats__item {
    padding: var(--spacing-sm);
    position: relative;
  }

  .stats__item:not(:last-child)::after {
    content: '';
    position: absolute;
    right: calc(var(--spacing-lg) / -2);
    top: 50%;
    transform: translateY(-50%);
    height: 56px;
    width: 1px;
    background-color: var(--hairline);
  }

  .stats__number {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 5vw, 3.75rem);
    font-weight: 500;
    color: var(--ink);
    line-height: 1;
    margin-bottom: 0.5rem;
    font-variant-numeric: tabular-nums;
  }

  .stats__label {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--ink-mute);
  }

  .stats__credentials {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-sm) var(--spacing-md);
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--ink-mute);
    padding-top: var(--spacing-lg);
    border-top: 1px solid var(--hairline);
  }

  .stats__dot {
    width: 3px;
    height: 3px;
    background-color: var(--bronze);
    border-radius: 50%;
  }

  /* Dual pathways */
  .paths {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  .paths__panel {
    position: relative;
    min-height: 540px;
    display: flex;
    align-items: flex-end;
    isolation: isolate;
    overflow: hidden;
  }

  .paths__panel img {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s cubic-bezier(0.22, 1, 0.36, 1);
  }

