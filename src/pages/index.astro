<script>
  function initCarousel() {
    const carousel = document.querySelector('[data-carousel]');
    if (!carousel) return;

    const slides = Array.from(carousel.querySelectorAll('[data-slide]'));
    const dots = Array.from(carousel.querySelectorAll('[data-dot]'));
    const prev = carousel.querySelector('[data-prev]');
    const next = carousel.querySelector('[data-next]');
    let current = 0;
    let timer: ReturnType<typeof setInterval> | undefined;

    const goTo = (index: number) => {
      current = (index + slides.length) % slides.length;
      slides.forEach((s, i) => s.classList.toggle('is-active', i === current));
      dots.forEach((d, i) => d.classList.toggle('is-active', i === current));
    };

    const restartTimer = () => {
      if (timer) clearInterval(timer);
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        timer = setInterval(() => goTo(current + 1), 7000);
      }
    };

    prev?.addEventListener('click', () => { goTo(current - 1); restartTimer(); });
    next?.addEventListener('click', () => { goTo(current + 1); restartTimer(); });
    dots.forEach((dot, i) => dot.addEventListener('click', () => { goTo(i); restartTimer(); }));

    restartTimer();
  }

  initCarousel();
  document.addEventListener('astro:after-swap', initCarousel);
</script>
