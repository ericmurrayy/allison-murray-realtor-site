---
import BaseLayout from '../layouts/BaseLayout.astro';

const buyingSteps = [
  {
    number: "01",
    title: "Initial Consultation",
    description: "We'll discuss your needs, preferences, budget, and timeline to create a personalized home search strategy."
  },
  {
    number: "02",
    title: "Get Pre-Approved",
    description: "I'll connect you with trusted lenders to get pre-approved, so you know exactly what you can afford."
  },
  {
    number: "03",
    title: "Home Search",
    description: "I'll curate listings that match your criteria and arrange private showings at your convenience."
  },
  {
    number: "04",
    title: "Make an Offer",
    description: "When you find the one, I'll help you craft a competitive offer and negotiate on your behalf."
  },
  {
    number: "05",
    title: "Close & Celebrate",
    description: "I'll guide you through inspections, appraisal, and closing to ensure a smooth path to your new home."
  }
];

const advantages = [
  {
    title: "Early Access to Listings",
    description: "I often hear about homes before they hit the market, giving you a competitive edge other buyers simply don't have."
  },
  {
    title: "Deep Local Knowledge",
    description: "I know these communities intimately — the best streets, school districts, and hidden gems that never make the headlines."
  },
  {
    title: "Strong Negotiation",
    description: "In a market of multiple offers, I'll advocate fiercely for your interests to win the home on the best possible terms."
  }
];

const communities = [
  { name: "Wellesley", slug: "wellesley", highlights: "Top schools, charming downtown, excellent commute" },
  { name: "Weston", slug: "weston", highlights: "Exclusive estates, conservation land, privacy" },
  { name: "Newton", slug: "newton", highlights: "Villages, restaurants, Green Line access" },
  { name: "Lexington", slug: "lexington", highlights: "Historic charm, top schools, family-friendly" },
  { name: "Needham", slug: "needham", highlights: "Community feel, great schools, dining" },
  { name: "Natick", slug: "natick", highlights: "Convenience, shopping, diverse housing" },
  { name: "Waltham", slug: "waltham", highlights: "Urban access, diverse options, value" }
];
---

<BaseLayout
  title="Buy a Home in Greater Boston"
  description="Find your dream home in Wellesley, Newton, Weston, Lexington, Needham, Natick, or Waltham MA. Expert buyer representation from Allison Murray, Realtor."
>
  <!-- Hero -->
  <section class="page-hero">
    <div class="page-hero__media">
      <img src="/images/hero-buy.jpg" alt="A sunny neighborhood street with classic New England homes" fetchpriority="high" />
    </div>
    <div class="page-hero__scrim"></div>
    <div class="container">
      <span class="eyebrow">For Buyers</span>
      <h1>Find the home<br /><em class="accent-italic">you've been imagining</em></h1>
      <p class="page-hero__lead">
        Whether you're a first-time buyer or moving up, I'll help you navigate
        Greater Boston's competitive market — and win the home that's right
        for your family.
      </p>
      <div class="page-hero__ctas">
        <a href="/contact" class="btn btn--primary btn--large">Start Your Home Search</a>
        <a href="/listings" class="btn btn--ghost btn--large">View Current Listings</a>
      </div>
    </div>
  </section>

  <!-- Advantages -->
  <section class="section section--white advantage">
    <div class="container">
      <div class="advantage__grid">
        <div class="advantage__content animate-slide-left">
          <span class="eyebrow">The Advantage</span>
          <h2>Your advocate in a<br /><em class="accent-italic">competitive market</em></h2>
          <p class="advantage__intro">
            The Greater Boston market moves fast — homes often receive
            multiple offers within days of listing. You need an agent who
            knows the market inside and out, and fights for you at every turn.
          </p>
          <div class="advantage__list">
            {advantages.map((item, i) => (
              <div class="advantage__item">
                <span class="advantage__number">{String(i + 1).padStart(2, '0')}</span>
                <div>
                  <h4>{item.title}</h4>
                  <p>{item.description}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
        <div class="advantage__image animate-slide-right">
          <div class="advantage__image-frame">
            <img src="/images/interior-living.jpg" alt="An elegant, light-filled living room" loading="lazy" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="section section--dark process">
    <div class="container container--narrow">
      <div class="section__header animate-on-scroll">
        <span class="eyebrow eyebrow--center">The Process</span>
        <h2>Five steps to home</h2>
      </div>
      <div class="process__timeline">
        {buyingSteps.map(step => (
          <div class="process__step animate-on-scroll">
            <span class="process__number">{step.number}</span>
            <div class="process__content">
              <h3>{step.title}</h3>
              <p>{step.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Communities -->
  <section class="section communities">
    <div class="container container--narrow">
      <div class="section__header animate-on-scroll">
        <span class="eyebrow eyebrow--center">Where to Look</span>
        <h2>Communities worth<br /><em class="accent-italic">calling home</em></h2>
      </div>
      <div class="communities__list animate-stagger">
        {communities.map(c => (
          <a href={`/areas/${c.slug}`} class="communities__row">
            <span class="communities__name">{c.name}</span>
            <span class="communities__highlights">{c.highlights}</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section section--dark cta">
    <div class="container">
      <div class="cta__content animate-on-scroll">
        <span class="eyebrow eyebrow--center">Let's Get Started</span>
        <h2>Your home search<br /><em class="accent-italic">starts with a conversation</em></h2>
        <p class="cta__text">
          Tell me what you're looking for, and I'll keep an eye out — including
          for homes that haven't hit the market yet.
        </p>
        <div class="cta__buttons">
          <a href="/contact" class="btn btn--primary btn--large">Start Your Search</a>
          <a href="tel:9788887649" class="btn btn--ghost btn--large">Call (978) 888-7649</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-sm);
    margin-top: var(--spacing-lg);
  }

  /* Advantage */
  .advantage__grid {
    display: grid;
    grid-template-columns: 6fr 5fr;
    gap: clamp(2.5rem, 6vw, 5.5rem);
    align-items: center;
  }

  .advantage__intro {
    font-size: 1.125rem;
    line-height: 1.8;
    color: var(--ink-mute);
    margin-bottom: var(--spacing-xl);
  }

  .advantage__list {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-lg);
  }

  .advantage__item {
    display: flex;
    gap: var(--spacing-md);
  }

  .advantage__number {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-style: italic;
    color: var(--bronze);
    flex-shrink: 0;
    padding-top: 2px;
  }

  .advantage__item h4 {
    margin-bottom: 0.375rem;
  }

  .advantage__item p {
    color: var(--ink-mute);
    font-size: 0.9375rem;
    line-height: 1.75;
    margin-bottom: 0;
  }

  .advantage__image-frame {
    position: relative;
    aspect-ratio: 4/5;
    overflow: hidden;
  }

  .advantage__image-frame::before {
    content: '';
    position: absolute;
    inset: 1.25rem -1.25rem -1.25rem 1.25rem;
    border: 1px solid var(--bronze-pale);
    z-index: -1;
  }

  .advantage__image-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Process */
  .process__timeline {
    display: flex;
    flex-direction: column;
  }

  .process__step {
    display: flex;
    gap: var(--spacing-xl);
    padding: var(--spacing-lg) 0;
    border-bottom: 1px solid var(--hairline-light);
  }

  .process__step:last-child {
    border-bottom: none;
  }

  .process__number {
    font-family: var(--font-display);
    font-size: 2.25rem;
    font-style: italic;
    color: var(--bronze-pale);
    flex-shrink: 0;
    width: 72px;
    line-height: 1;
  }

  .process__content h3 {
    font-size: 1.5rem;
    margin-bottom: var(--spacing-xs);
  }

  .process__content p {
    color: rgba(250, 248, 244, 0.65);
    margin-bottom: 0;
    font-size: 0.9875rem;
    line-height: 1.8;
  }

  /* Communities list */
  .communities__list {
    display: flex;
    flex-direction: column;
  }

  .communities__row {
    display: grid;
    grid-template-columns: 160px 1fr auto;
    align-items: center;
    gap: var(--spacing-md);
    padding: var(--spacing-md) 0;
    border-bottom: 1px solid var(--hairline);
    transition: padding-left var(--transition-base);
  }

  .communities__row:hover {
    padding-left: 0.75rem;
  }

  .communities__name {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 500;
    color: var(--ink);
  }

  .communities__highlights {
    font-size: 0.9375rem;
    color: var(--ink-mute);
  }

  .communities__row svg {
    color: var(--bronze);
    transition: transform var(--transition-base);
  }

  .communities__row:hover svg {
    transform: translateX(5px);
  }

  /* CTA */
  .cta__content {
    text-align: center;
    max-width: 720px;
    margin: 0 auto;
  }

  .cta__text {
    font-size: 1.125rem;
    color: rgba(250, 248, 244, 0.72);
    margin-bottom: var(--spacing-xl);
  }

  .cta__buttons {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--spacing-sm);
  }

  @media (max-width: 900px) {
    .advantage__grid {
      grid-template-columns: 1fr;
    }

    .advantage__image {
      max-width: 440px;
      margin: 0 auto;
      width: 100%;
    }

    .communities__row {
      grid-template-columns: 1fr auto;
    }

    .communities__highlights {
      grid-column: 1 / -1;
      grid-row: 2;
    }
  }

  @media (max-width: 600px) {
    .process__step {
      flex-direction: column;
      gap: var(--spacing-sm);
    }

    .process__number {
      width: auto;
    }

    .cta__buttons {
      flex-direction: column;
      align-items: center;
    }
  }
</style>
