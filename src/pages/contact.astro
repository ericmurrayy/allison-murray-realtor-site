---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact"
  description="Get in touch with Allison Murray, Realtor. Serving Wellesley, Newton, Weston, Lexington, and Greater Boston. Call (978) 888-7649."
>
  <!-- Hero -->
  <section class="page-hero page-hero--short">
    <div class="page-hero__media">
      <img src="/images/interior-dining.jpg" alt="A sunlit dining room with bay windows" fetchpriority="high" />
    </div>
    <div class="page-hero__scrim"></div>
    <div class="container">
      <span class="eyebrow">Let's Connect</span>
      <h1>The first conversation<br /><em class="accent-italic">is always free</em></h1>
      <p class="page-hero__lead">
        Ready to buy or sell? Have questions about the market? I'd love to
        hear from you — and I respond within 24 hours.
      </p>
    </div>
  </section>

  <!-- Contact -->
  <section class="section section--white contact">
    <div class="container">
      <div class="contact__grid">
        <div class="contact__info animate-slide-left">
          <span class="eyebrow">Direct</span>
          <h2>Allison Murray</h2>
          <p class="contact__title">Realtor&reg; &middot; Chinatti Realty Group</p>
          <p class="contact__tagline">
            Greater Boston &amp; MetroWest Move-Up and Luxury Home Specialist
          </p>

          <div class="contact__methods">
            <a href="tel:9788887649" class="contact__method">
              <span class="contact__method-label">Phone</span>
              <span class="contact__method-value">(978) 888-7649</span>
            </a>
            <a href="mailto:allison@chinattirealty.com" class="contact__method">
              <span class="contact__method-label">Email</span>
              <span class="contact__method-value">allison@chinattirealty.com</span>
            </a>
            <a href="https://www.chinattirealty.com/agents/allison-murray/" target="_blank" rel="noopener" class="contact__method">
              <span class="contact__method-label">Listings</span>
              <span class="contact__method-value">chinattirealty.com</span>
            </a>
          </div>

          <div class="contact__areas">
            <h3>Service Areas</h3>
            <p>
              Wellesley, Weston, Newton, Lexington, Needham, Natick, Waltham,
              and surrounding Greater Boston communities.
            </p>
          </div>
        </div>

        <div class="contact__form-wrapper animate-slide-right">
          <div class="contact__form-card form-card">
            <h2>Send a Message</h2>
            <p class="contact__form-note">Fill out the form below and I'll get back to you within 24 hours.</p>

            <form class="contact__form" action="https://formspree.io/f/YOUR_FORMSPREE_ID" method="POST">
              <input type="hidden" name="_subject" value="New Contact from AllisonMurrayRealtor.com" />
              <input type="hidden" name="_next" value="/contact?success=true" />

              <div class="form__row">
                <div class="form__group">
                  <label for="firstName">First Name *</label>
                  <input type="text" id="firstName" name="firstName" required />
                </div>
                <div class="form__group">
                  <label for="lastName">Last Name *</label>
                  <input type="text" id="lastName" name="lastName" required />
                </div>
              </div>

              <div class="form__row">
                <div class="form__group">
                  <label for="email">Email Address *</label>
                  <input type="email" id="email" name="email" required />
                </div>
                <div class="form__group">
                  <label for="phone">Phone Number</label>
                  <input type="tel" id="phone" name="phone" />
                </div>
              </div>

              <div class="form__group">
                <label for="interest">I'm Interested In *</label>
                <select id="interest" name="interest" required>
                  <option value="">Select an option...</option>
                  <option value="selling">Selling my home</option>
                  <option value="buying">Buying a home</option>
                  <option value="valuation">Home valuation</option>
                  <option value="both">Buying &amp; Selling</option>
                  <option value="other">Other inquiry</option>
                </select>
              </div>

              <div class="form__group">
                <label for="message">Message *</label>
                <textarea id="message" name="message" rows="4" required placeholder="Tell me about your real estate goals..."></textarea>
              </div>

              <button type="submit" class="btn btn--primary btn--large form__submit">
                Send Message
              </button>

              <p class="form__disclaimer">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                Your information is secure and will never be shared.
              </p>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Prefer to talk -->
  <section class="section section--dark alt-cta">
    <div class="container">
      <div class="alt-cta__content animate-on-scroll">
        <div class="alt-cta__text">
          <span class="eyebrow">Prefer to Talk?</span>
          <h2>I'm always happy to chat</h2>
          <p>Give me a call and let's discuss your real estate goals — no pressure, no obligation.</p>
        </div>
        <a href="tel:9788887649" class="btn btn--primary btn--large">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
          </svg>
          Call (978) 888-7649
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero--short {
    min-height: 52vh;
  }

  .contact__grid {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: start;
  }

  .contact__title {
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--bronze);
    margin-bottom: var(--spacing-xs);
  }

  .contact__tagline {
    color: var(--ink-mute);
    margin-bottom: var(--spacing-lg);
  }

  .contact__methods {
    display: flex;
    flex-direction: column;
    margin-bottom: var(--spacing-lg);
  }

  .contact__method {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    padding: var(--spacing-md) 0;
    border-bottom: 1px solid var(--hairline);
    transition: padding-left var(--transition-base);
  }

  .contact__method:first-child {
    border-top: 1px solid var(--hairline);
  }

  .contact__method:hover {
    padding-left: 0.625rem;
  }

  .contact__method-label {
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--ink-mute);
  }

  .contact__method-value {
    font-family: var(--font-display);
    font-size: 1.375rem;
    color: var(--ink);
  }

  .contact__method:hover .contact__method-value {
    color: var(--bronze);
  }

  .contact__areas h3 {
    font-size: 1.125rem;
    margin-bottom: var(--spacing-xs);
  }

  .contact__areas p {
    color: var(--ink-mute);
    font-size: 0.9375rem;
    line-height: 1.8;
    margin-bottom: 0;
  }

  .contact__form-card {
    background-color: var(--paper);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-lg);
    padding: clamp(1.75rem, 4vw, 2.75rem);
  }

  .contact__form-card h2 {
    font-size: 1.75rem;
    margin-bottom: 0.25rem;
  }

  .contact__form-note {
    color: var(--ink-mute);
    font-size: 0.9375rem;
    margin-bottom: var(--spacing-lg);
  }

  .form__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-sm);
  }

  .form__submit {
    width: 100%;
  }

  /* Alt CTA */
  .alt-cta__content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-xl);
    flex-wrap: wrap;
  }

  .alt-cta__text p {
    color: rgba(250, 248, 244, 0.72);
    margin-bottom: 0;
    max-width: 480px;
  }

  @media (max-width: 900px) {
    .contact__grid {
      grid-template-columns: 1fr;
    }

    .alt-cta__content {
      flex-direction: column;
      text-align: center;
    }

    .alt-cta__text .eyebrow {
      justify-content: center;
    }
  }

  @media (max-width: 480px) {
    .form__row {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }
</style>
