---
import BaseLayout from '../layouts/BaseLayout.astro';

const testimonials = [
  {
    quote: "Allison made selling our home in Wellesley effortless. Her market knowledge and negotiation skills got us well above asking price! She handled every detail with professionalism and kept us informed throughout the process.",
    author: "The Richardson Family",
    location: "Wellesley, MA",
    type: "Seller",
    highlight: "Sold above asking price"
  },
  {
    quote: "Professional, responsive, and genuinely caring. Allison found us our dream home in Newton within weeks. She understood exactly what we were looking for and never wasted our time with properties that didn't fit.",
    author: "Sarah & David M.",
    location: "Newton, MA",
    type: "Buyer",
    highlight: "Found dream home quickly"
  },
  {
    quote: "We interviewed several agents but chose Allison for her honesty and deep understanding of the Lexington market. Best decision we made! She gave us realistic expectations and then exceeded them.",
    author: "The Chen Family",
    location: "Lexington, MA",
    type: "Seller",
    highlight: "Expert market knowledge"
  },
  {
    quote: "Allison helped us navigate a very competitive market in Needham. Her strategic approach got our offer accepted over multiple competing bids. We couldn't be happier in our new home!",
    author: "Mike & Jennifer T.",
    location: "Needham, MA",
    type: "Buyer",
    highlight: "Won in competitive market"
  },
  {
    quote: "As first-time sellers, we were nervous about the process. Allison walked us through every step, from staging advice to closing. Her patience and expertise made all the difference.",
    author: "The Patel Family",
    location: "Natick, MA",
    type: "Seller",
    highlight: "Excellent guidance for first-time sellers"
  },
  {
    quote: "Allison represented both the sale of our Weston home and purchase of our new place in Newton. She coordinated everything seamlessly—truly a white-glove experience.",
    author: "Robert & Lisa K.",
    location: "Weston to Newton",
    type: "Buyer & Seller",
    highlight: "Seamless buy/sell coordination"
  },
  {
    quote: "What sets Allison apart is her responsiveness. No matter when we had a question, she got back to us quickly. In a fast-moving market, that made all the difference.",
    author: "The Williams Family",
    location: "Wellesley, MA",
    type: "Buyer",
    highlight: "Always responsive"
  },
  {
    quote: "Allison's marketing for our home was outstanding. Professional photos, virtual tour, and strategic social media exposure brought multiple offers within the first week.",
    author: "John & Mary S.",
    location: "Newton, MA",
    type: "Seller",
    highlight: "Multiple offers in first week"
  },
  {
    quote: "We relocated from out of state and Allison made the process so much easier. She gave us virtual tours, answered countless questions, and helped us understand the different neighborhoods.",
    author: "The Anderson Family",
    location: "Lexington, MA",
    type: "Buyer",
    highlight: "Excellent relocation support"
  }
];

const stats = [
  { value: 100, suffix: "+", label: "Homes Sold" },
  { value: 5, suffix: ".0", label: "Average Rating" },
  { value: 98, suffix: "%", label: "Client Satisfaction" },
  { value: 95, suffix: "%", label: "Referral Rate" }
];
---

<BaseLayout
  title="Client Reviews"
  description="Read what clients say about working with Allison Murray, Realtor. Reviews from home buyers and sellers in Wellesley, Newton, Lexington, and Greater Boston."
>
  <!-- Hero -->
  <section class="page-hero page-hero--short">
    <div class="page-hero__media">
      <img src="/images/interior-family.jpg" alt="A bright, welcoming family room" fetchpriority="high" />
    </div>
    <div class="page-hero__scrim"></div>
    <div class="container">
      <span class="eyebrow">Client Stories</span>
      <h1>Real results for<br /><em class="accent-italic">real families</em></h1>
      <p class="page-hero__lead">
        Here's what buyers and sellers across Greater Boston have to say about
        working together.
      </p>
    </div>
  </section>

  <!-- Stats -->
  <section class="rstats">
    <div class="container">
      <div class="rstats__grid">
        {stats.map(stat => (
          <div class="rstats__item">
            <span
              class="rstats__number"
              data-count={stat.value}
              data-suffix={stat.suffix}
            >{stat.value + stat.suffix}</span>
            <span class="rstats__label">{stat.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="section testimonials">
    <div class="container">
      <div class="testimonials__grid">
        {testimonials.map(testimonial => (
          <figure class="tcard animate-on-scroll">
            <div class="tcard__stars" aria-label="5 star review">
              {Array.from({ length: 5 }).map(() => (
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
              ))}
            </div>
            <blockquote class="tcard__text">&ldquo;{testimonial.quote}&rdquo;</blockquote>
            <figcaption class="tcard__footer">
              <div class="tcard__info">
                <span class="tcard__name">{testimonial.author}</span>
                <span class="tcard__location">{testimonial.location} &middot; {testimonial.type}</span>
              </div>
              <span class="tcard__highlight">{testimonial.highlight}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section section--dark cta">
    <div class="container">
      <div class="cta__content animate-on-scroll">
        <span class="eyebrow eyebrow--center">Your Turn</span>
        <h2>Ready to have a<br /><em class="accent-italic">great experience?</em></h2>
        <p class="cta__text">
          Let's talk about your real estate goals. I'd love the opportunity to
          earn a review like these from you.
        </p>
        <div class="cta__buttons">
          <a href="/contact" class="btn btn--primary btn--large">Get In Touch</a>
          <a href="tel:9788887649" class="btn btn--ghost btn--large">Call (978) 888-7649</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero--short {
    min-height: 52vh;
  }

  /* Stats */
  .rstats {
    background-color: var(--paper);
    padding: var(--spacing-2xl) 0;
    border-bottom: 1px solid var(--hairline);
  }

  .rstats__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--spacing-lg);
    text-align: center;
  }

  .rstats__number {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    font-weight: 500;
    color: var(--ink);
    line-height: 1;
    margin-bottom: 0.5rem;
    font-variant-numeric: tabular-nums;
  }

  .rstats__label {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--ink-mute);
  }

  /* Testimonials */
  .testimonials__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--spacing-md);
  }

  .tcard {
    display: flex;
    flex-direction: column;
    background-color: var(--white);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-md);
    padding: var(--spacing-lg);
    transition: box-shadow var(--transition-base), transform var(--transition-base);
  }

  .tcard:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-3px);
  }

  .tcard__stars {
    display: flex;
    gap: 3px;
    color: var(--bronze);
    margin-bottom: var(--spacing-sm);
  }

  .tcard__text {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-style: italic;
    line-height: 1.65;
    color: var(--ink);
    margin-bottom: var(--spacing-md);
    flex: 1;
  }

  .tcard__footer {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    padding-top: var(--spacing-sm);
    border-top: 1px solid var(--hairline);
  }

  .tcard__name {
    display: block;
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--ink);
  }

  .tcard__location {
    display: block;
    font-size: 0.8125rem;
    color: var(--ink-mute);
  }

  .tcard__highlight {
    align-self: flex-start;
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--bronze);
  }

  /* CTA */
  .cta__content {
    text-align: center;
    max-width: 720px;
    margin: 0 auto;
  }

  .cta__text {
    font-size: 1.125rem;
    color: rgba(250, 248, 244, 0.72);
    margin-bottom: var(--spacing-xl);
  }

  .cta__buttons {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--spacing-sm);
  }

  @media (max-width: 980px) {
    .testimonials__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 700px) {
    .rstats__grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .testimonials__grid {
      grid-template-columns: 1fr;
    }

    .cta__buttons {
      flex-direction: column;
      align-items: center;
    }
  }
</style>
