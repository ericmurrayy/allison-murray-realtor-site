---
import BaseLayout from '../layouts/BaseLayout.astro';

const credentials = [
  "Licensed Massachusetts Real Estate Agent",
  "Member, Massachusetts Association of Realtors",
  "Member, National Association of Realtors",
  "Chinatti Realty Group"
];

const values = [
  {
    title: "Client-First Approach",
    description: "Your goals are my goals. I listen carefully to understand what matters most to you and tailor my approach accordingly."
  },
  {
    title: "Integrity Always",
    description: "I believe in honest, transparent communication. You'll always know where things stand and have the information you need to make informed decisions."
  },
  {
    title: "Excellence in Service",
    description: "From our first conversation to closing and beyond, I'm committed to providing exceptional service at every step."
  },
  {
    title: "Local Expertise",
    description: "I live and work in the communities I serve. I know the neighborhoods, schools, and what makes each area special."
  }
];
---

<BaseLayout
  title="About Allison"
  description="Learn about Allison Murray, a trusted real estate agent serving Wellesley, Newton, Weston, and Greater Boston. Specializing in luxury and move-up homes."
>
  <!-- Hero -->
  <section class="page-hero page-hero--short">
    <div class="page-hero__media">
      <img src="/images/about-hero.jpg" alt="An elegant living room with coffered ceilings" fetchpriority="high" />
    </div>
    <div class="page-hero__scrim"></div>
    <div class="container">
      <span class="eyebrow">About Allison</span>
      <h1>Your partner in<br /><em class="accent-italic">Greater Boston real estate</em></h1>
    </div>
  </section>

  <!-- Bio -->
  <section class="section section--white bio">
    <div class="container">
      <div class="bio__grid">
        <div class="bio__image animate-slide-left">
          <div class="bio__image-frame">
            <img
              src="/allison-headshot.jpg"
              alt="Allison Murray - Greater Boston Realtor"
              onerror="this.src='/headshot-placeholder.svg'"
            />
          </div>
        </div>

        <div class="bio__content animate-slide-right">
          <span class="eyebrow">The Story</span>
          <h2>More than a transaction —<br /><em class="accent-italic">a next chapter</em></h2>
          <p class="bio__lead">
            As a Greater Boston &amp; MetroWest Move-Up and Luxury Home
            Specialist, I bring deep local knowledge and a genuine passion for
            helping families find their perfect home.
          </p>
          <p>
            Real estate is more than a transaction — it's about helping people
            take the next step in their lives. Whether you're selling your
            family home of 20 years or searching for the perfect place to
            raise your children, I understand the significance of this decision.
          </p>
          <p>
            My approach is simple: listen carefully, provide expert guidance,
            and work tirelessly to achieve the best possible outcome for my
            clients.
          </p>

          <ul class="bio__credentials">
            {credentials.map(credential => (
              <li>
                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                {credential}
              </li>
            ))}
          </ul>

          <div class="bio__ctas">
            <a href="/contact" class="btn btn--primary">Get In Touch</a>
            <a href="/sell" class="btn btn--secondary">Sell Your Home</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Values -->
  <section class="section section--light values">
    <div class="container">
      <div class="section__header animate-on-scroll">
        <span class="eyebrow eyebrow--center">What I Stand For</span>
        <h2>The principles behind<br /><em class="accent-italic">every relationship</em></h2>
      </div>

      <div class="values__grid animate-stagger">
        {values.map((value, i) => (
          <div class="values__card">
            <span class="values__number">{String(i + 1).padStart(2, '0')}</span>
            <h3>{value.title}</h3>
            <p>{value.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Story -->
  <section class="section story">
    <div class="container container--narrow">
      <div class="section__header animate-on-scroll">
        <span class="eyebrow eyebrow--center">Why I Do This</span>
        <h2>Why I love what I do</h2>
      </div>

      <div class="story__content animate-fade">
        <p>
          I got into real estate because I genuinely love helping people. There's nothing quite like
          handing over the keys to a family's new home or seeing the relief and excitement when a
          seller accepts an offer that exceeds their expectations.
        </p>
        <p>
          Having lived in the Greater Boston area for years, I've developed deep roots in these
          communities. I know which neighborhoods are walkable to the best coffee shops, which
          streets have the friendliest neighbors, and which hidden gems might be the perfect fit
          for your family.
        </p>
        <p>
          At Chinatti Realty Group, I'm surrounded by experienced professionals who share my
          commitment to excellence. Together, we bring the resources and expertise of a top
          brokerage with the personalized attention of a boutique firm.
        </p>
        <p>
          Whether you're buying or selling, I'd love the opportunity to learn about your goals
          and show you how I can help you achieve them.
        </p>
      </div>

      <div class="story__cta animate-fade">
        <a href="/contact" class="btn btn--dark btn--large">Let's Connect</a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section section--dark cta">
    <div class="container">
      <div class="cta__content animate-on-scroll">
        <span class="eyebrow eyebrow--center">Work Together</span>
        <h2>Ready when<br /><em class="accent-italic">you are</em></h2>
        <p class="cta__text">
          Whether you're thinking of selling or searching for your next home,
          I'd love to hear from you.
        </p>
        <div class="cta__buttons">
          <a href="/sell" class="btn btn--primary btn--large">Get Your Home Valuation</a>
          <a href="tel:9788887649" class="btn btn--ghost btn--large">Call (978) 888-7649</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero--short {
    min-height: 52vh;
  }

  /* Bio */
  .bio__grid {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: clamp(2.5rem, 6vw, 5.5rem);
    align-items: center;
  }

  .bio__image-frame {
    position: relative;
    aspect-ratio: 4/5;
    overflow: hidden;
  }

  .bio__image-frame::before {
    content: '';
    position: absolute;
    inset: 1.25rem -1.25rem -1.25rem 1.25rem;
    border: 1px solid var(--bronze-pale);
    z-index: -1;
  }

  .bio__image-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }

  .bio__lead {
    font-size: 1.1875rem;
    line-height: 1.8;
    color: var(--ink);
  }

  .bio__credentials {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    margin: var(--spacing-lg) 0;
    padding: var(--spacing-md) 0;
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
  }

  .bio__credentials li {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-size: 0.9375rem;
    color: var(--ink-soft);
  }

  .bio__credentials svg {
    color: var(--bronze);
    flex-shrink: 0;
  }

  .bio__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-sm);
  }

  /* Values */
  .values__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--spacing-lg);
  }

  .values__card {
    padding-top: var(--spacing-md);
    border-top: 1px solid var(--hairline);
  }

  .values__number {
    display: block;
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-style: italic;
    color: var(--bronze);
    margin-bottom: var(--spacing-sm);
  }

  .values__card h3 {
    font-size: 1.375rem;
    margin-bottom: var(--spacing-xs);
  }

  .values__card p {
    font-size: 0.9375rem;
    line-height: 1.75;
    color: var(--ink-mute);
    margin-bottom: 0;
  }

  /* Story */
  .story__content {
    font-size: 1.0625rem;
    line-height: 1.9;
    color: var(--ink-soft);
  }

  .story__content p {
    margin-bottom: var(--spacing-md);
  }

  .story__cta {
    text-align: center;
    margin-top: var(--spacing-xl);
  }

  /* CTA */
  .cta__content {
    text-align: center;
    max-width: 720px;
    margin: 0 auto;
  }

  .cta__text {
    font-size: 1.125rem;
    color: rgba(250, 248, 244, 0.72);
    margin-bottom: var(--spacing-xl);
  }

  .cta__buttons {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--spacing-sm);
  }

  @media (max-width: 900px) {
    .bio__grid {
      grid-template-columns: 1fr;
    }

    .bio__image {
      max-width: 420px;
      margin: 0 auto;
      width: 100%;
    }

    .values__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .values__grid {
      grid-template-columns: 1fr;
    }

    .cta__buttons {
      flex-direction: column;
      align-items: center;
    }
  }
</style>
